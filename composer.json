{
  "name": "sugarcommerce/network",
  "description": "Who a WordPress request is from: the visitor's real IP behind proxies, their country, language, browser and bots, where they came from, and the email address they gave -- and what the site runs on: web server, PHP limits, disk and environment.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/network",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "sugarcommerce/plugin": "dev-main"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../plugin",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Network\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarcommerce/network/issues",
    "source": "https://github.com/sugarcommerce/network"
  },
  "keywords": [
    "wordpress",
    "ip",
    "cidr",
    "proxy",
    "cloudflare",
    "geoip",
    "country",
    "user-agent",
    "bot-detection",
    "referrer",
    "utm",
    "attribution",
    "email",
    "gdpr",
    "accept-language",
    "server",
    "environment"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Network\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php",
      "/tests/Remote/stubs.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
