{
  "name": "sugarcommerce/network",
  "version": "1.7.0",
  "description": "Request-level network utilities: spoof-resistant client IP behind proxies and CDNs, CIDR matching, GDPR anonymisation, user-agent and bot detection, referrer and campaign attribution. Zero dependencies.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/network",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["ip", "cidr", "proxy", "cloudflare", "user-agent", "bot-detection", "referrer", "utm", "gdpr", "anonymization"],
  "require": { "php": ">=8.5" },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\Network\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\Network\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit", "bench": "php -d opcache.enable_cli=1 bench/run.php" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarcommerce/network/issues",
    "source": "https://github.com/sugarcommerce/network"
  }
}
